%% Boxes are the things the model holds; rounded tinted nodes are the
%% operations that take you from one box to the next. Combining value
%% dimensions is a single step that both the learned probability and the
%% shown magnitude feed into.
flowchart LR
  OH["Outcome<br>History"] --> LM(["Learning<br>Model"])
  LM --> LP["Learned<br>Probability"]
  LP --> CV(["Combining<br>Value Dims"])
  SM["Shown<br>Magnitude"] --> CV
  CV --> DV["Decision<br>Variable"]

  classDef state fill:#ffffff,stroke:#14171a,stroke-width:1.5px,color:#14171a;
  classDef op fill:#f4f6f7,stroke:#7d868d,stroke-width:1.2px,color:#14171a;
  class OH,LP,SM,DV state;
  class LM,CV op;
