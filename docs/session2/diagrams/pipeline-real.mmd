%% The same shape as recovery.mmd, so that going from this slide to the next
%% reads as one change: participants swapped for a model we set ourselves.
flowchart LR
  T["Task schedule"] --> PP(["Participants<br>play it"])
  PP --> D["Real<br>choices"]
  D --> FIT(["Fit the<br>model"])
  FIT --> R["Estimated<br>parameters"]
  R --> Q{{"Are they right?<br>No way to tell"}}

  classDef state fill:#ffffff,stroke:#14171a,stroke-width:1.5px,color:#14171a;
  classDef op fill:#f4f6f7,stroke:#7d868d,stroke-width:1.2px,color:#14171a;
  classDef out fill:#ffffff,stroke:#14171a,stroke-width:3px,color:#14171a;
  class T,D,R state;
  class PP,FIT op;
  class Q out;
