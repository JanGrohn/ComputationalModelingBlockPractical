%% model-choice.mmd, one step further: simulating a choice.
flowchart TB
  OH["Outcome History"] -- "Learning model" --> LP["Learned Probability"]
  LP --> CV(["Combining<br>value dims"])
  SM["Shown Magnitude"] --> CV
  CV --> DV["Decision Variable"]
  DV -- "Softmax decision rule" --> CP["Choice Probability"]
  CP -- "Simulation: compare<br>with a random number" --> MC["Model Choices"]

  classDef state fill:#ffffff,stroke:#14171a,stroke-width:1.5px,color:#14171a;
  classDef op fill:#f4f6f7,stroke:#7d868d,stroke-width:1.2px,color:#14171a;
  classDef out fill:#ffffff,stroke:#14171a,stroke-width:3px,color:#14171a;
  class OH,LP,SM,DV,CP state;
  class CV op;
  class MC out;
