%% The original deck's overview: where each session's piece of the model sits,
%% and how simulated choices loop back to stand in for real data.
flowchart LR
  D["Data from real participants<br>or simulated data"] --> L(["Session 1 · reinforcement learner<br>δ = o − p,  p ← p + αδ<br>free parameter α"])
  L --> U(["Session 2 · utility<br>u = m × p"])
  U --> S(["Session 2 · softmax<br>P(c₁) from u₁ − u₂<br>free parameter β"])
  S --> C(["Session 2 · simulate a choice<br>compare P(c₁) with<br>a random number"])
  C --> D
  L2(["Later · two learning rates<br>αₛ and αᵥ"]) -.- L

  classDef state fill:#ffffff,stroke:#14171a,stroke-width:1.5px,color:#14171a;
  classDef op fill:#f4f6f7,stroke:#7d868d,stroke-width:1.2px,color:#14171a;
  class D state;
  class L,U,S,C,L2 op;
